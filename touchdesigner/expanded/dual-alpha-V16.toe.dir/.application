
#Desk..
# layout 
desk -c * 
desk -n pane1 *
desk -h pane1 0.729644 -n pane2

#pane1
desk -p /project1/SYNCD pane1
desk -t neteditor pane1
desk -k 0 pane1
neteditor -c 0 -e 1 -G 0.75 -o 0 -r 1 -P 0.8 -s 0 -w 0 -x 0 -t 0 -d 1 -g 0 -p pane1

#pane2
desk -p /project1/SYNCD pane2
desk -t topviewer pane2
desk -k 0 pane2
neteditor -c 0 -e 1 -G 0.75 -o 0 -r 1 -P 0.8 -s 0 -w 0 -x 0 -t 1 -d 1 -g 0 -p pane2

browser off
winplacement ontop=0 mode=auto posx=0 posy=0 sizex=1024 sizey=768 enable=1 perform.path=/perform perform.start=0
